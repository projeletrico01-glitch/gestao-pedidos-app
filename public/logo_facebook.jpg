                <div class="def-40-px def-h-100 absolute z-index-1 top-0 right-0 bg-blue display-800-none"></div>
                <form action="https://www.termoprol.com.br/contato/store" method="POST" class="display-inline-block def-800-px max-w-100 bg-white relative z-index-2 f-none def-form" id="fContact">
                    <input type="hidden" name="_token" value="" autocomplete="off">                    <label class="def-100 m-bottom-10 t-align-c color-blue f-size-35 m-top-1024-0 f-size-1024-26 f-size-600-2">
                        Ou envie uma mensagem
                    </label>
                    <fieldset class="def-49 m-top-20 w-800-100">
                        <input class="def-100 b-radius-10 overflow-h" type="text" name="name" placeholder="Nome *" required />
                    </fieldset>
                    <fieldset class="def-49 f-right m-top-20 w-800-100">
                        <input class="def-100 b-radius-10 overflow-h masked-phone" type="text" name="phone" placeholder="Telefone *" required />
                    </fieldset>
                    <fieldset class="def-100 m-top-20">
                        <input class="def-100 b-radius-10 overflow-h" type="email" name="email" placeholder="E-mail *" required />
                    </fieldset>
                    <fieldset class="def-100 m-top-20">
                        <textarea class="def-100 b-radius-10 overflow-h" name="message" placeholder="Mensagem *" required></textarea>
                    </fieldset>
						<input type="hidden" required id="g-recaptcha-response-footer" name="g-recaptcha-response" />
                    <div class="def-100 m-top-40 t-align-c m-top-1024-20 send-contact">
                        <div class="display-inline-block">
                            <div class="f-left relative">
                                <input class="def-230-px b-radius-10 pointer smooth" type="submit" value="ENVIAR" />
                                <img class="def-100 absolute top-100 left-0 m-top-3-neg" src="https://www.termoprol.com.br/assets/site/images/icons/ice.png" title="ENVIAR" alt="ENVIAR" loading="lazy" />
                            </div>
                        </div>
                    </div>
                    <div class="def-msg m-top-30 def-100 f-size-16 t-align-c"></div>
                </form>
            </div>
        </div>
